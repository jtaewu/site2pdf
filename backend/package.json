{
  "name": "site2pdf",
  "version": "0.1.0",
  "private": true,
  "description": "승인된 웹사이트/로컬 정적 사이트를 안전하게 탐색해 PDF로 변환하는 CLI (엔진)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cli": "node src/cli/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest.mjs run",
    "test:unit": "node scripts/vitest.mjs run tests/unit",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "playwright": "^1.65.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
